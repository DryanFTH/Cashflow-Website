{
    "name": "cashflow-management",
    "version": "0.1.0",
    "author": "DryanFTH",
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm typecheck  && pnpm format:check",
        "postinstall": "prisma generate",
        "db:setup": "prisma migrate deploy",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy && prisma generate",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset",
        "bootstrap": "pnpm install && pnpm db:setup",
        "sync": "git pull && pnpm install && pnpm db:deploy"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@prisma/adapter-libsql": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@tanstack/react-query": "^5.101.1",
        "@tanstack/react-table": "^8.21.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "dotenv": "^17.4.2",
        "lucide-react": "^1.21.0",
        "next": "16.2.9",
        "next-themes": "^0.4.6",
        "prisma": "^7.8.0",
        "radix-ui": "^1.6.0",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.80.0",
        "recharts": "^3.9.0",
        "shadcn": "^4.11.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "prettier": "^3.6.2",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
